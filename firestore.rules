rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isConfiguredOwner() {
      return signedIn()
        && request.auth.token.email == 'matthewcauman@gmail.com';
    }

    function memberPath() {
      return /databases/$(database)/documents/Workspaces/addie-enterprises/members/$(request.auth.uid);
    }

    function isMember() {
      return signedIn()
        && exists(memberPath())
        && get(memberPath()).data.active != false;
    }

    function isAdmin() {
      return isConfiguredOwner()
        || (
          isMember()
          && get(memberPath()).data.role in ['owner', 'admin']
        );
    }

    match /Workspaces/addie-enterprises/items/{itemId} {
      allow read, create, update, delete: if isMember() || isConfiguredOwner();
    }

    match /Workspaces/addie-enterprises/members/{userId} {
      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      // Allows the configured owner to restore their member record
      // if Firebase issues a new UID.
      allow create: if isAdmin()
        && (
          userId == request.auth.uid
          || isAdmin()
        );

      allow update, delete: if isAdmin();
    }

    match /Workspaces/addie-enterprises/accessRequests/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending';

      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow update, delete: if isAdmin();
    }
  }
}
